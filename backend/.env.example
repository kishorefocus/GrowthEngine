# ─── Core ─────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/growthengine
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=changeme-at-least-32-chars-please-replace
FRONTEND_URL=https://www.getyourclientsb2b.com
API_URL=http://localhost:8000
ENCRYPTION_KEY=                          # generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DRY_RUN=true                             # set to false to enable live sends/posts

# ─── AI ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=
SENDING_DOMAIN=                          # e.g. getyourclientsb2b.co (never the main domain)
PHYSICAL_ADDRESS=                        # required in email footer (CAN-SPAM)
UNSUBSCRIBE_SECRET=changeme-unsubscribe-secret

# ─── Social (official APIs only) ──────────────────────────────────────────────
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202610                   # LinkedIn monthly API version (YYYYMM)
LINKEDIN_ORGANIZATION_ID=                    # Optional: organization numeric ID if posting to company page
META_APP_ID=
META_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=                    # YouTube Data API + Google OAuth login

# ─── Storage (Cloudflare R2 / S3-compatible) ──────────────────────────────────
S3_ENDPOINT=
S3_BUCKET=
S3_KEY=
S3_SECRET=

# ─── GlobalReach dogfooding ───────────────────────────────────────────────────
GLOBALREACH_API_URL=
GLOBALREACH_API_KEY=

# ─── Signup webhook from main product ─────────────────────────────────────────
SIGNUP_WEBHOOK_SECRET=changeme-webhook-secret

# ─── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=

# ─── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=local
APP_NAME=GlobalReach Growth Engine API
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
